#include "common.h"
#include "screenspace_mvectors.h"
#include "anthology_snow_field.h"
Texture2D<float2> snow_tracks;
float4 snow_track_field; // centre xz, reciprocal width, texel size in metres
float snow_track(float2 world)
{
    return snow_tracks.SampleLevel(smp_base, world*snow_track_field.z, 0).r;
}
struct snow_output {
    float4 hpos:SV_Position;
    float3 world:TEXCOORD0;
    float3 view:TEXCOORD1;
    float4 current:TEXCOORD2;
    float4 previous:TEXCOORD3;
    float cover:TEXCOORD4;
    float3 normal:TEXCOORD5;
};
f_deffer main(snow_output I)
{
    // Density controls geometry coverage, never the opacity of a snowdrift.
    // In empty patches keep the original ground and its depth untouched.
    clip(I.cover - (0.001 / 0.035));
    float3 N=normalize(I.normal);
    if(N.y<0) N=-N;
    // Fine detail fades before becoming subpixel noise in the distance.
    float footprint=max(length(ddx(I.world)),length(ddy(I.world)));
    float detail=1-smoothstep(.008,.04,footprint);
    float grain=snow_field_noise(I.world.xz*83.0)-.5;
    float broad=snow_field_noise(I.world.xz*.55);
    float2 track=snow_tracks.SampleLevel(smp_base,I.world.xz*snow_track_field.z,0);
    float valid=all(abs(I.world.xz-snow_track_field.xy)<(0.49/snow_track_field.z)) &&
        track.r>.001 && abs(I.world.y-track.g/max(track.r,.001))<1.3;
    float2 e=float2(snow_track_field.w,0);
    float2 gradient=float2(snow_track(I.world.xz+e)-snow_track(I.world.xz-e),
        snow_track(I.world.xz+e.yx)-snow_track(I.world.xz-e.yx));
    N=normalize(N+float3(gradient.x,0,gradient.y)*(.025/(2*snow_track_field.w))*valid);
    float3 viewN=mul((float3x3)m_V,N);
    float3 albedo=(.65+.10*broad+grain*.04*detail)*float3(.94,.97,1);
    albedo*=1-.06*track.r*valid;
    // Snow is its own opaque surface. Screen-space ground samples also contain
    // foreground props; inheriting their lighting imprinted their silhouettes.
    f_deffer O=pack_gbuffer(float4(viewN,.7),float4(I.view,.95),float4(albedo,.035));
    O.velocity=ssfx_mv_calc(I.current,I.previous,0,0);
    return O;
}
