#include "common.h"

struct p_sun_out
{
    float4 rt1  : SV_Target0;
    float4 rt2 	: SV_Target1;
	float4 heat : SV_Target2;
};

p_sun_out main ( p_TL I ) : SV_Target
{
	p_sun_out O;
	
	float4 result = s_base.Sample( smp_base, I.Tex0 )*I.Color;
	
	O.rt1 = result;
    // The second sky target feeds legacy bloom; never leave an MRT undefined.
    O.rt2 = float4(result.rgb / def_hdr, result.a);
	
	if (result.a > 0.4) 
	{
        O.heat = float4(0.0, (result.r + result.g + result.b)/3.0f, 0.0, 1.0);
    } 
	else 
	{
        O.heat = float4(0.0, 0.0, 0.0, 0.0);
    }
	
	
	return O;
}
