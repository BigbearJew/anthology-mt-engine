uniform float4 ssfx_issvp;
#define SSFX_PIP_SSS_NOISE_TIME (timers.x * (1.0f - step(0.5f, ssfx_issvp.x)))
/**
 * @ Version: SCREEN SPACE SHADERS - UPDATE 22
 * @ Description: Screen Space Shadows - Direct Light + Far Shadows
 * @ Modified time: 2026-08-27 (Anthology SSS 23.5 lighting restore)
 * @ Author: https://www.moddb.com/members/ascii1457
 * @ Mod: https://www.moddb.com/mods/stalker-anomaly/addons/screen-space-shaders
 */

#include "screenspace_shadows.h"

float4x4 m_current;
float4x4 m_previous;

Texture2D sss_image;
Texture2D s_prev_pos;

float4 main(p_screen I) : SV_Target
{
	float2 tc = I.tc0;
	float2 Pos2D = I.hpos;

#ifndef USE_MSAA
	float4 Pos = s_position.Sample(smp_nofilter, tc);
#else
	float4 Pos = s_position.Load(int3(Pos2D, 0), 0);
#endif

	float3 Motion_Vectors = s_motion_vectors.Sample(smp_nofilter, tc);
	float3 P = float3(Pos.z * (Pos2D * pos_decompression_params.zw - pos_decompression_params.xy), Pos.z);
	float3 N = gbuf_unpack_normal(Pos.xy);
	float mtl = gbuf_unpack_mtl(Pos.w);

	float4 sss = 0.0f;
	sss.r = SSFX_ScreenSpaceShadows(float4(P, mtl), N, tc, Motion_Vectors.z, 0);

	// Sparse captures cannot accumulate the main view's motion/depth history.
	if (ssfx_issvp.x > 0.5f) return float4(sss.r, 0.25f, sss.r, 0.0f);
	float4 P4 = float4(P, 1.0f);
	float4 p_current = mul(m_current, P4);
	float4 p_previous = mul(m_previous, P4);
	float2 current = p_current.xy / p_current.w;
	float2 previous = p_previous.xy / p_previous.w;

	float2 cam_rp = current.xy - previous.xy;
	cam_rp = float2(cam_rp.x, -cam_rp.y) * 0.5f;

	float residual_velocity = length(Motion_Vectors.xy - cam_rp * (1.0f - Motion_Vectors.z));
	float vel_history = residual_velocity * 200.0f;
	float vel = length(Motion_Vectors.xy);

	float4 prev_P = s_prev_pos.Sample(smp_rtlinear, tc - Motion_Vectors.xy);
	float docc = saturate(abs(1.0f - P.z / prev_P.z));
	docc *= 1.0f + 10.0f * Motion_Vectors.z;

	float2 rnd = hash22(tc * 100 + timers.xx * 100) * 2.0f - 1.0f;
	rnd = rnd * (1.0f / screen_res.xy) * 0.5f * saturate(1.0f - vel * 10.0f);

	float4 prev = sss_image.Sample(smp_rtlinear, (tc + rnd) - Motion_Vectors.xy);
	float outoffsrc = any((tc - Motion_Vectors.xy) < 0) + any((tc - Motion_Vectors.xy) > 1.0f);
	outoffsrc = lerp(outoffsrc, prev.a, 0.95f);

	float2 weight = 0;
	vel *= 30.0f * Motion_Vectors.z;
	weight.x = saturate(0.95f - (outoffsrc + docc + vel));
	weight.y = saturate(0.60f - (outoffsrc + docc));
	sss.rg = lerp(float2(sss.r, docc), prev.rg, weight.xy);

	return float4(sss.rg, 1, max(outoffsrc, lerp(saturate(vel_history), prev.w, 0.95f)));
}
