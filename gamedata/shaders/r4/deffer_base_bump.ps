#include "common.h"
#include "sload.h"
#include "screenspace_mvectors.h"

f_deffer main ( p_bumped I )
{
	f_deffer O;

	surface_bumped S = sload(I);

	// Sample normal, rotate it by matrix, encode position 
	float3 Ne = mul(float3x3(I.M1, I.M2, I.M3), S.normal);
		   Ne = normalize(Ne);

		
#ifdef ANTHOLOGY_SNOW_SINGLE_GROUND
    if (abs(anthology_flora_style.x - 4.0) < 0.1)
        anthology_snow_surface(I.position.xyz, float3(I.M1.z,I.M2.z,I.M3.z), Ne, S.base.rgb, S.gloss);
#endif
    // hemi,sun,material
		float 	ms	= xmaterial;
	#ifdef USE_LM_HEMI
		float4 lm = s_hemi.Sample( smp_rtlinear, I.lmh);
		float h = get_hemi(lm);
		#ifdef USE_R2_STATIC_SUN
			ms = get_sun(lm);
		#endif
	#else
		float h = I.position.w;
		#ifdef USE_R2_STATIC_SUN
			ms = I.tcdh.w;
		#endif
	#endif

	O = pack_gbuffer(
		float4(Ne, h),
		float4(I.position.xyz + Ne * S.height * def_virtualh, ms),
		float4(S.base.xyz, S.gloss)
	);

	// Motion vectors
	O.velocity = ssfx_mv_calc(I.vel_curr, I.vel_prev, 0, 0);

	return O;
}
