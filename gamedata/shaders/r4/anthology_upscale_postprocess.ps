#include "common.h"
#include "hdr10.h"

Texture2D s_base0;
Texture2D s_base1;
Texture2D s_noise;

uniform float4 c_brightness;
uniform float4 anthology_upscaler_params; // x: DLSS-only display sharpen

float3 sample_present(Texture2D source, float2 tc)
{
	float3 center = source.SampleLevel(smp_rtlinear, tc, 0.0f).rgb;
	float strength = saturate(anthology_upscaler_params.x);
	float3 result = center;
	[branch]
	if (strength > 0.0001f)
	{
		// NGX 3.10 ignores its deprecated InSharpness parameter. Use a compact
		// optional four-neighbour unsharp pass for DLSS only; FSR keeps its native
		// RCAS path and presentation remains a single sample when strength is zero.
		float3 north = source.SampleLevel(smp_rtlinear, tc, 0.0f, int2(0, -1)).rgb;
		float3 south = source.SampleLevel(smp_rtlinear, tc, 0.0f, int2(0, 1)).rgb;
		float3 west = source.SampleLevel(smp_rtlinear, tc, 0.0f, int2(-1, 0)).rgb;
		float3 east = source.SampleLevel(smp_rtlinear, tc, 0.0f, int2(1, 0)).rgb;
		float3 detail = center - 0.25f * (north + south + west + east);
		result = max(center + detail * (0.45f * strength), 0.0f);
	}
	return result;
}

float4 main(p_postpr I) : SV_Target
{
	// Vendor reconstruction and the SSS display combine already produced the
	// final display-sized image. Keep presentation to one filtered sample so
	// the upscaler's GPU saving is not spent again on a mandatory 9-tap CAS.
	float3 image = sample_present(s_base0, I.Tex0);
	[branch]
	if (any(abs(I.Tex0 - I.Tex1) >= 0.000001f))
		image = 0.5f * (image + sample_present(s_base1, I.Tex1));

	float gray = dot(image, I.Gray);
	image = lerp(gray, image, I.Gray.w);
	float3 noised = image * s_noise.Sample(smp_linear, I.Tex2).rgb * 2.0f;
	image = lerp(noised, image, I.Color.w);
	image = (image * I.Color + c_brightness) * 2.0f;
	return float4(HDR10_ToDisplay_World(image), 1.0f);
}
