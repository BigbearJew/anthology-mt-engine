Texture2D<float4> s_image;
float4 anthology_upscale_linear;
float3 prepare_color(float3 color)
{
    // FSR consumes linear RGB. DLSS LDR explicitly consumes gamma-encoded RGB.
    return anthology_upscale_linear.x > 0.5 ? pow(max(color, 0), 2.2) : color;
}

#ifdef UPSCALE_PREPARE_DEPTH
Texture2D<float> s_depth;
Texture2D<float4> s_forward_delta;
struct UpscaleInputs
{
	float4 color : SV_Target0;
	float depth : SV_Target1;
	float reactive : SV_Target2;
};

UpscaleInputs main(float4 position : SV_Position)
{
	int3 pixel = int3(position.xy, 0);
	UpscaleInputs result;
	result.color = float4(prepare_color(s_image.Load(pixel).rgb), 1.0f);
	result.depth = s_depth.Load(pixel);
	// Forward water/particles cannot use the motion of the opaque surface behind
	// them. Mark their contribution in the same raster grid as color and depth.
	float3 delta = abs(s_forward_delta.Load(pixel).rgb);
	float strength = max(delta.r, max(delta.g, delta.b));
	result.reactive = anthology_upscale_linear.y * (anthology_upscale_linear.x > 0.5
		? min(0.9, strength * 4.0) : step(0.03, strength));
	return result;
}
#else
float4 main(float4 position : SV_Position) : SV_Target
{
	// Keep the existing display-referred signal without filtering subpixels.
	return float4(s_image.Load(int3(position.xy, 0)).rgb, 1.0f);
}
#endif
